rules_version = '2';

// Access is role-based. Each signed-in staff account has a document at
// roles/{auth uid} = { role, staffId }, written only by an administrator
// (or, once, by whoever sets the hospital up). Patient-portal accounts have
// { role: 'patient', patientId } and see only their own records. Accounts
// without a role document can read nothing, so signing up to the project
// grants no access.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function roleDoc() {
      return /databases/$(database)/documents/roles/$(request.auth.uid);
    }

    function hasRoleDoc() {
      return signedIn() && exists(roleDoc());
    }

    function isStaff() {
      return hasRoleDoc() && get(roleDoc()).data.role != 'patient';
    }

    function isPatient() {
      return hasRoleDoc() && get(roleDoc()).data.role == 'patient';
    }

    function myPatientId() {
      return get(roleDoc()).data.patientId;
    }

    // A patient's own record (an existing document).
    function ownRecord() {
      return isPatient() && resource.data.patientId == myPatientId();
    }

    function ownNewRecord() {
      return isPatient() && request.resource.data.patientId == myPatientId();
    }

    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function patientDoc(id) {
      return /databases/$(database)/documents/patients/$(id);
    }

    function hasRole(roles) {
      return isStaff() && get(roleDoc()).data.role in roles;
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    function myStaffId() {
      return get(roleDoc()).data.staffId;
    }

    function setupDone() {
      return exists(/databases/$(database)/documents/meta/setup);
    }

    // --- Accounts ------------------------------------------------------------

    // First-run bootstrap: while no hospital exists, a signed-in user may make
    // themselves administrator, in the same batch that marks setup as done.
    match /meta/setup {
      allow read: if signedIn();
      allow create: if signedIn() && !setupDone()
        && getAfter(roleDoc()).data.role == 'admin';
    }

    match /roles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && !setupDone()
        && existsAfter(/databases/$(database)/documents/meta/setup)
        && request.resource.data.role == 'admin';
      allow create, update, delete: if isAdmin();
      // Reception gives patients portal accounts.
      allow create: if hasRole(['receptionist'])
        && request.resource.data.role == 'patient'
        && request.resource.data.keys().hasOnly(['role', 'patientId'])
        && exists(patientDoc(request.resource.data.patientId));
      allow delete: if hasRole(['receptionist']) && resource.data.role == 'patient';
      // A new patient registering online: only together with a brand-new
      // patient record that this account owns.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'patient'
        && request.resource.data.keys().hasOnly(['role', 'patientId'])
        && !exists(patientDoc(request.resource.data.patientId))
        && getAfter(patientDoc(request.resource.data.patientId)).data.portalUid
          == request.auth.uid;
    }

    match /users/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // MRN, invoice and queue-token sequences.
    match /meta/counters {
      allow read, write: if isStaff();
    }

    // --- Clinical records ----------------------------------------------------

    match /patients/{id} {
      allow read: if isStaff() || (isPatient() && id == myPatientId());
      allow create, update: if hasRole(['admin', 'receptionist']);
      allow delete: if isAdmin();
      // Patients keep their own contact details up to date.
      allow update: if isPatient() && id == myPatientId()
        && changesOnly(['phone', 'email', 'address']);
      // Online registration (see roles): a new record for this account,
      // without insurance, which reception verifies.
      allow create: if signedIn() && !hasRoleDoc()
        && request.resource.data.id == id
        && request.resource.data.portalUid == request.auth.uid
        && request.resource.data.insurerId == null
        && getAfter(roleDoc()).data.role == 'patient'
        && getAfter(roleDoc()).data.patientId == id;
    }

    // Doctors book follow-ups and move patients through their queue.
    match /appointments/{id} {
      allow read: if isStaff() || ownRecord();
      allow create, update: if hasRole(['admin', 'receptionist', 'doctor']);
      allow delete: if isAdmin();
      // Patients book online for themselves, and may cancel a booking.
      allow create: if ownNewRecord()
        && request.resource.data.channel == 'online'
        && request.resource.data.status == 'scheduled'
        && request.resource.data.tokenNumber == null
        && request.resource.data.bookedBy == null;
      allow update: if ownRecord() && resource.data.status == 'scheduled'
        && request.resource.data.status == 'cancelled'
        && changesOnly(['status']);
    }

    // Times taken by appointments, without patient details, so the portal
    // can show free slots. The id is doctor + start time: a second booking
    // of the same slot is an update, which patients may not make.
    match /bookedSlots/{id} {
      allow read: if isStaff() || isPatient();
      allow write: if hasRole(['admin', 'receptionist', 'doctor']);
      allow create: if isPatient()
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId))
          .data.patientId == myPatientId();
      allow delete: if isPatient()
        && get(/databases/$(database)/documents/appointments/$(resource.data.appointmentId))
          .data.patientId == myPatientId();
    }

    // Doctors' names, specialities, fees and leave dates for the portal,
    // kept up to date by staff devices.
    match /directory/{id} {
      allow read: if isStaff() || isPatient();
      allow write: if isStaff();
    }

    match /consultations/{id} {
      allow read: if isStaff();
      allow create, update: if hasRole(['admin', 'doctor']);
      allow delete: if isAdmin();
    }

    // --- Laboratory ----------------------------------------------------------

    match /labTests/{id} {
      allow read: if isStaff();
      allow write: if hasRole(['admin', 'labTechnician']);
    }

    // Doctors order (and mark results reviewed); the lab records results.
    match /labOrders/{id} {
      // Patients see results once their doctor has reviewed them.
      allow read: if isStaff() || (ownRecord() && resource.data.reviewedByDoctor == true);
      allow create: if hasRole(['admin', 'doctor']);
      allow update: if hasRole(['admin', 'doctor', 'labTechnician']);
      allow delete: if isAdmin();
    }

    // --- Pharmacy ------------------------------------------------------------

    match /medicines/{id} {
      allow read: if isStaff();
      allow write: if hasRole(['admin', 'pharmacist']);
    }

    // Doctors prescribe; the pharmacy dispenses.
    match /prescriptions/{id} {
      allow read: if isStaff() || ownRecord();
      allow create: if hasRole(['admin', 'doctor']);
      allow update: if hasRole(['admin', 'doctor', 'pharmacist']);
      allow delete: if isAdmin();
    }

    // --- Billing -------------------------------------------------------------

    // Every department adds charges to a visit's invoice; reception and the
    // pharmacy take payments.
    match /invoices/{id} {
      allow read: if isStaff() || ownRecord();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // The lab removes the charge for a cancelled test.
    match /invoiceLines/{id} {
      allow read, write: if isStaff();
      allow read: if ownRecord();
    }

    // --- Wards and operation theatre -----------------------------------------

    match /rooms/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /theatres/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Admission, transfer and discharge.
    match /admissions/{id} {
      allow read: if isStaff();
      allow create, update: if hasRole(['admin', 'receptionist', 'doctor', 'nurse']);
      allow delete: if isAdmin();
    }

    // Doctors book surgeries; theatre nurses start and complete them.
    match /surgeries/{id} {
      allow read: if isStaff();
      allow create: if hasRole(['admin', 'doctor']);
      allow update: if hasRole(['admin', 'doctor', 'nurse']);
      allow delete: if isAdmin();
    }

    // --- Payments, HR and finance ---------------------------------------------

    // Payments taken at the counter go into the cashier's own open till.
    match /payments/{id} {
      allow read: if isStaff();
      allow create: if hasRole(['admin', 'receptionist', 'pharmacist', 'accountant'])
        && (request.resource.data.get('tillId', null) == null
          || isMyOpenTill(request.resource.data.tillId));
      allow update, delete: if isAdmin();
    }

    function isMyOpenTill(tillId) {
      let till = getAfter(/databases/$(database)/documents/tills/$(tillId)).data;
      return till.cashierId == myStaffId() && till.closedAt == null;
    }

    // Cash tills: a cashier opens and closes their own; once closed only
    // administrators and accounts can change one (or close a forgotten one).
    match /tills/{id} {
      allow read: if hasRole(['admin', 'receptionist', 'pharmacist', 'accountant']);
      allow create: if hasRole(['admin', 'receptionist', 'pharmacist', 'accountant'])
        && request.resource.data.cashierId == myStaffId()
        && request.resource.data.closedAt == null;
      allow update: if hasRole(['admin', 'accountant'])
        || (hasRole(['receptionist', 'pharmacist'])
          && resource.data.cashierId == myStaffId()
          && resource.data.closedAt == null
          && request.resource.data.cashierId == myStaffId()
          && request.resource.data.openingFloat == resource.data.openingFloat);
    }

    // Anyone may request leave for themselves; only an admin decides.
    match /leaves/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.status == 'pending'
        && (request.resource.data.staffId == myStaffId() || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Salaries and the hospital's spending are confidential.
    match /salaries/{id} {
      allow read, write: if hasRole(['admin', 'accountant']);
    }

    match /payslips/{id} {
      allow read, write: if hasRole(['admin', 'accountant']);
    }

    match /expenses/{id} {
      allow read, write: if hasRole(['admin', 'accountant']);
    }

    // --- Insurance ------------------------------------------------------------

    match /insurers/{id} {
      allow read: if isStaff();
      allow write: if hasRole(['admin', 'accountant']);
    }

    match /claims/{id} {
      allow read: if isStaff();
      allow create, update, delete: if hasRole(['admin', 'receptionist', 'accountant']);
    }

    // --- Pharmacy purchasing --------------------------------------------------

    match /suppliers/{id} {
      allow read: if isStaff();
      allow write: if hasRole(['admin', 'pharmacist']);
    }

    // The pharmacy orders and receives goods; accounts can only record the
    // supplier payment.
    match /purchaseOrders/{id} {
      allow read: if isStaff();
      allow create, delete: if hasRole(['admin', 'pharmacist']);
      allow update: if hasRole(['admin', 'pharmacist'])
        || (hasRole(['accountant'])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['paidAt', 'expenseId']));
    }

    // Hospital details printed on documents.
    match /settings/{id} {
      allow read: if isStaff() || isPatient();
      allow write: if isAdmin();
    }

    // --- Scheduling -------------------------------------------------------------

    // Doctors set their own working hours; administrators set anyone's.
    match /schedules/{doctorId} {
      allow read: if isStaff() || isPatient();
      allow write: if isAdmin() || (hasRole(['doctor']) && myStaffId() == doctorId);
    }

    // Reminders are queued with appointments by whoever books them, and
    // marked sent by staff (or by the reminder Cloud Function, which uses
    // the Admin SDK).
    match /reminders/{id} {
      allow read: if isStaff() || ownRecord();
      allow create, update: if hasRole(['admin', 'receptionist', 'doctor']);
      // Online bookings queue their own reminders; cancelling withdraws them.
      allow create: if ownNewRecord() && request.resource.data.status == 'pending';
      allow update: if ownRecord() && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && changesOnly(['status']);
    }

    // --- Nursing care ----------------------------------------------------------

    // Observations, doses given and notes are clinical records: added by
    // clinical staff and never edited afterwards.
    match /vitals/{id} {
      allow read: if isStaff();
      allow create: if hasRole(['admin', 'doctor', 'nurse']);
    }

    match /medicationDoses/{id} {
      allow read: if isStaff();
      allow create: if hasRole(['admin', 'doctor', 'nurse']);
    }

    match /nursingNotes/{id} {
      allow read: if isStaff();
      allow create: if hasRole(['admin', 'doctor', 'nurse']);
    }

    // Doctors prescribe ward medicines and stop them.
    match /medicationOrders/{id} {
      allow read: if isStaff();
      allow create, update: if hasRole(['admin', 'doctor']);
    }

    // --- Audit log --------------------------------------------------------------

    // Every device appends entries in its own name; only administrators read
    // them, and nobody can change or remove them.
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isStaff() && request.resource.data.userId == myStaffId();
      allow create: if isPatient() && request.resource.data.userId == myPatientId();
    }

    // --- Notifications -------------------------------------------------------

    match /notifications/{id} {
      allow read, create: if isStaff();
      // The portal tells reception about online bookings and cancellations.
      allow create: if ownNewRecord()
        && request.resource.data.targetRole == 'receptionist'
        && request.resource.data.targetUserId == null
        && request.resource.data.readBy.size() == 0;
      // Staff may only mark notifications as read.
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      allow delete: if isAdmin();
    }
  }
}
